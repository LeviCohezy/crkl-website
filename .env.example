# Copy to .env.local and fill in. Never commit .env.local.

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical origin, used for metadata, sitemap and absolute OG image URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Media ───────────────────────────────────────────────────────────────────
# Leave empty to serve images/videos from /public (the default).
# Set to a CDN or bucket origin to serve them from there instead, e.g.
# "https://cdn.crkl.wine" or a Vercel Blob / Cloudflare R2 public URL.
NEXT_PUBLIC_MEDIA_BASE_URL=""

# ─── Commerce (not wired up yet — see docs/ECOMMERCE-ROADMAP.md) ─────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Accounts / database (not wired up yet) ──────────────────────────────────
# DATABASE_URL=""
# AUTH_SECRET=""

# ─── Reservation & contact forms ─────────────────────────────────────────────
# Valid requests are POSTed here as JSON. Leave it empty and the forms fall
# back to handing the visitor a pre-written e-mail. See src/lib/enquiry.ts.
# ENQUIRY_WEBHOOK_URL=""
